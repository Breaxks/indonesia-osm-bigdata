# Raw data: never commit the 1.6 GB PBF, wherever it is
*.osm.pbf
*.pbf

# Processed outputs (regenerated by the pipeline)
backend/data/processed/*
!backend/data/processed/.gitkeep
backend/data/models/*
!backend/data/models/.gitkeep
backend/data/outputs/*
!backend/data/outputs/.gitkeep

# GeoJSON: ignore generated province files, keep the boundary file the pipeline needs
backend/data/geojson/*
!backend/data/geojson/.gitkeep
!backend/data/geojson/_province_boundaries_fallback.geojson

# Python
backend/venv/
backend/.venv/
**/__pycache__/
*.pyc
.env

# Spark
backend/spark-warehouse/
backend/metastore_db/
backend/derby.log

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# OS / editor
.DS_Store
.vscode/
.idea/